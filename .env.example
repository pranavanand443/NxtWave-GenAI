# Required for live generation and evaluation. Never commit your real key.
GOOGLE_API_KEY=your-gemini-api-key

# One centralized model setting for generator and evaluator.
GEMINI_MODEL=gemini-3.7-flash

# Provider retries handle transient API transport failures; workflow retries handle lesson quality.
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
WORKFLOW_MAX_RETRIES=2

OUTPUT_DIR=outputs
MEMORY_DB_PATH=data/lesson_memory.sqlite3
